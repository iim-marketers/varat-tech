
# Defaults to https://home.mdmlocker.in when unset.
NEXT_PUBLIC_SITE_URL=

# Razorpay public key id (safe to expose). Defaults to the live key from the brief.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

RAZORPAY_KEY_SECRET=


NEXT_PUBLIC_META_PIXEL_ID=

# Search console ownership tokens (content value only, not the full <meta> tag). Optional.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
