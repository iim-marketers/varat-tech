# Razorpay public key id (safe to expose). Defaults to the live key from the brief.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Razorpay key secret — server only. When set, checkout creates a Razorpay order
# and verifies the payment signature before showing the success screen / firing Purchase.
RAZORPAY_KEY_SECRET=

# Default Meta Pixel id. Can be overridden per campaign with /start/?fb_pixel=<id>
NEXT_PUBLIC_META_PIXEL_ID=
